{
  "info": {
    "name": "SBA301 Lab 04.1 - REST + MongoDB",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Create category (get real categoryId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Accessories\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"categoryId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "01 POST valid product (#1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"price\": 120.0,\n  \"stock\": 20,\n  \"categoryId\": \"{{categoryId}}\",\n  \"sku\": \"KB-{{$timestamp}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Location header\", function () { pm.response.to.have.header(\"Location\"); });",
              "pm.collectionVariables.set(\"productId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
