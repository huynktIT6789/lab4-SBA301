      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"code\", function(){ pm.expect(pm.response.json().code).to.eql(\"VALIDATION_ERROR\"); });"
            ]
          }
        }
      ]
    },
