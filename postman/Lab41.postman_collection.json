            "{{productId}}",
            "reviews"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"u1\",\n  \"rating\": 5,\n  \"comment\": \"Great keyboard\"\n}"
        },
        "description": "Sau request nay mo Compass: review nam trong product document."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"review embedded\", function(){ pm.expect(pm.response.json().reviews.length).to.be.at.least(1); });"
            ]
          }
        }
      ]
